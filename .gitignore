# Claude Code 本地配置（每个人的设置不同，不应共享）
# 注意：不能写 .claude/，否则 git 不进入该目录，!例外规则失效
.claude/*
!.claude/agents
!.claude/agents/**

# ── 操作系统自动生成的垃圾文件 ──────────────────────────
# macOS 文件夹预览缓存
.DS_Store
# Windows 文件夹缩略图缓存
Thumbs.db
# Windows 文件夹显示设置
desktop.ini

# ── 编辑器 / IDE 配置 ────────────────────────────────────
# VS Code 工作区私有配置（调试路径、个人快捷键等）
.vscode/
# JetBrains 系列（WebStorm / IntelliJ 等）
.idea/
# Vim 编辑时产生的临时交换文件
*.swp
*.swo

# ── Node.js（未来如果引入构建工具会用到）────────────────
# 第三方依赖包，体积巨大，应通过 npm install 重新生成
node_modules/
# npm / yarn / pnpm 的错误日志
npm-debug.log*
yarn-error.log
.pnpm-debug.log*

# ── 环境变量文件（可能包含密钥，绝对不能提交）──────────
.env
.env.local
.env*.local

# ── 构建产物（未来打包输出目录）────────────────────────
dist/
build/
